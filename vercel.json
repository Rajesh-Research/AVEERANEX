{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/products/learn",
      "destination": "https://aveeranex-learn.vercel.app/index.html"
    },
    {
      "source": "/products/learn/",
      "destination": "https://aveeranex-learn.vercel.app/index.html"
    },
    {
      "source": "/products/learn/admin",
      "destination": "https://aveeranex-learn.vercel.app/admin/index.html"
    },
    {
      "source": "/products/learn/admin/",
      "destination": "https://aveeranex-learn.vercel.app/admin/index.html"
    },
    {
      "source": "/products/learn/:path*",
      "destination": "https://aveeranex-learn.vercel.app/products/learn/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
